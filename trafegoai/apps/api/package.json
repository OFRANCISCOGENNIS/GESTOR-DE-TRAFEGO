{
  "name": "@trafegoai/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "meta:doctor": "ts-node -r dotenv/config scripts/meta-doctor.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "10.3.10",
    "@nestjs/core": "10.3.10",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.3.10",
    "@nestjs/platform-socket.io": "10.3.10",
    "@nestjs/websockets": "10.3.10",
    "@prisma/client": "5.17.0",
    "bullmq": "5.12.0",
    "dotenv": "^17.4.2",
    "ioredis": "5.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.2",
    "@nestjs/testing": "10.3.10",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.11",
    "jest": "29.7.0",
    "prisma": "5.17.0",
    "ts-jest": "29.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
