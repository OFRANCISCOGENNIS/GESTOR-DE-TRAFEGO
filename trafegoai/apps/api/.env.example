# Banco e fila
DATABASE_URL=postgresql://trafegoai:trafegoai@localhost:5432/trafegoai
REDIS_URL=redis://localhost:6379

# Segurança
JWT_SECRET=troque-em-producao
ENCRYPTION_KEY=troque-esta-chave-para-32-bytes  # usada no AES-256-GCM dos tokens OAuth
PW_SALT=trafegoai

# ── Meta Marketing API (Facebook e Instagram Ads) ──────────────────────────
# A API é gratuita. Crie o app em https://developers.facebook.com
# (tipo Empresa) e adicione o produto "Marketing API".
# Em Configurações → Básico ficam o ID do app e a chave secreta.
META_APP_ID=
META_APP_SECRET=
# Precisa ser idêntica à URI cadastrada no app da Meta (Login do Facebook → Configurações)
META_REDIRECT_URI=http://localhost:3333/connections/meta/callback
META_API_VERSION=v21.0
# URL pública desta API (usada para montar o redirect quando o de cima não é definido)
API_URL=http://localhost:3333

# IA (opcional — sem chave, usa fallback heurístico)
ANTHROPIC_API_KEY=

# Radar de vídeos — YouTube Data API v3 (opcional; sem chave usa dados curados)
YOUTUBE_API_KEY=

# Billing (opcional — sem chave, checkout roda em modo demo)
STRIPE_SECRET_KEY=

# CORS
WEB_ORIGIN=http://localhost:3000
PORT=3333
