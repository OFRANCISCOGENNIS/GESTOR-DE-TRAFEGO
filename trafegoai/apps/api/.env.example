# Banco e fila
DATABASE_URL=postgresql://trafegoai:trafegoai@localhost:5432/trafegoai
REDIS_URL=redis://localhost:6379

# Segurança
JWT_SECRET=troque-em-producao
ENCRYPTION_KEY=troque-esta-chave-para-32-bytes  # usada no AES-256-GCM dos tokens OAuth
PW_SALT=trafegoai

# IA (opcional — sem chave, usa fallback heurístico)
ANTHROPIC_API_KEY=

# Radar de vídeos — YouTube Data API v3 (opcional; sem chave usa dados curados)
YOUTUBE_API_KEY=

# Billing (opcional — sem chave, checkout roda em modo demo)
STRIPE_SECRET_KEY=

# CORS
WEB_ORIGIN=http://localhost:3000
PORT=3333
